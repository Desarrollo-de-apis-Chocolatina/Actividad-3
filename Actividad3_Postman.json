{
  "info": {
    "name": "Actividad 3 - Task Manager API",
    "description": "Colección de endpoints para probar la Actividad 3: v2 schema, state machine, audit y búsqueda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tareas (V2 - asignado objeto)",
      "item": [
        {
          "name": "GET - Listar tareas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/tareas",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas"]
            }
          }
        },
        {
          "name": "GET - Listar tareas (filtro asignado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/tareas?asignado=alisson quijano",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas"],
              "query": [
                { "key": "asignado", "value": "alisson quijano" }
              ]
            }
          }
        },
        {
          "name": "POST - Crear tarea (asignado objeto)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asignado\": { \"nombre\": \"Alisson Quijano\"},\n  \"peso\": 4,\n  \"titulo\": \"Tarea V2\",\n  \"descripcion\": \"Creada con esquema V2\"\n}"
            },
            "url": { "raw": "http://localhost:3000/tareas", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["tareas"] }
          }
        },
        {
          "name": "POST - Crear batch de tareas (asignado objeto)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"asignado\": { \"nombre\": \"Christian Renderos\" },\n    \"peso\": 2,\n    \"titulo\": \"Testing endpoints\",\n    \"descripcion\": \"Hacer pruebas manuales en Postman\"\n  },\n  {\n    \"asignado\": { \"nombre\": \"Gabriel Martínez\" },\n    \"peso\": 4,\n    \"titulo\": \"Documentación\",\n    \"descripcion\": \"Documentar API en Swagger\"\n  }\n]"
            },
            "url": { "raw": "http://localhost:3000/tareas/batch", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["tareas","batch"] }
          }
        },
        {
          "name": "GET - Obtener tarea por ID",
          "request": { "method": "GET", "header": [], "url": { "raw": "http://localhost:3000/tareas/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["tareas","1"] } }
        },
        {
          "name": "PUT - Actualizar tarea (asignado objeto)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"asignado\": { \"nombre\": \"Alejandra Arriola\" },\n  \"peso\": 6,\n  \"titulo\": \"Diseño mejorado\",\n  \"descripcion\": \"Refactorizar endpoints\"\n}" },
            "url": { "raw": "http://localhost:3000/tareas/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["tareas","1"] }
          }
        },
        {
          "name": "DELETE - Eliminar tarea",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "http://localhost:3000/tareas/1", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["tareas","1"] } }
        },
        {
          "name": "DELETE - Eliminar batch de tareas",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"ids\": [1,2,3] }" },
            "url": { "raw": "http://localhost:3000/tareas/batch", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["tareas","batch"] }
          }
        }
      ]
    },
    {
      "name": "Reasignación - PATCH",
      "item": [
        {
          "name": "PATCH - Reasignar tarea (string)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoAsignado\": \"Christian Renderos\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/tareas/1/asignado",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas", "1", "asignado"],
              "query": []
            },
            "description": "Reasigna una tarea a otra persona (acepta string)"
          }
        },
        {
          "name": "PATCH - Reasignar tarea (objeto)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoAsignado\": {\n    \"nombre\": \"Gabriel Martínez\",\n    \"email\": \"gabriel@example.com\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/tareas/1/asignado",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas", "1", "asignado"]
            },
            "description": "Reasigna una tarea (acepta objeto con nombre, id, email)"
          }
        }
      ]
    },
