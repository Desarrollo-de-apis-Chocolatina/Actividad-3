    {
      "name": "Búsqueda Full-Text",
      "item": [
        {
          "name": "GET - Buscar por descripción y asignado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/tareas/buscar?q=API",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas", "buscar"],
              "query": [
                {
                  "key": "q",
                  "value": "API"
                }
              ]
            },
            "description": "Búsqueda insensible a mayúsculas y acentos en descripción y nombre de asignado"
          }
        },
        {
          "name": "GET - Buscar por nombre (sin acentos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/tareas/buscar?q=gabriel martinez",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas", "buscar"],
              "query": [
                {
                  "key": "q",
                  "value": "gabriel martinez"
                }
              ]
            },
            "description": "Busca 'gabriel martinez' y debe encontrar 'Gabriel Martínez' (ignora acentos)"
          }
        },
        {
          "name": "GET - Buscar múltiples palabras",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/tareas/buscar?q=alisson endpoints",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tareas", "buscar"],
              "query": [
                {
                  "key": "q",
                  "value": "alisson endpoints"
                }
              ]
            },
            "description": "Busca que contenga AMBAS palabras (AND)"
          }
        }
      ]
    },
